{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LRO进阶客户端",
  "version": "0.1.0",
  "identifier": "com.ioft.lroclient",
  "build": {
    "beforeDevCommand": { "script": "pnpm build:native", "cwd": "..", "wait": true },
    "beforeBuildCommand": { "script": "pnpm build:native", "cwd": ".." },
    "frontendDist": "../../dist-native"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "create": false,
      "title": "LRO进阶客户端",
      "useHttpsScheme": true,
      "backgroundThrottling": "disabled"
    }],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://game.lastro.cn https://rodata.ltsd.ro",
        "media-src": "'self' data: blob: https://game.lastro.cn https://rodata.ltsd.ro",
        "font-src": "'self' data: blob: https://game.lastro.cn https://rodata.ltsd.ro",
        "connect-src": "'self' data: blob: ipc: http://ipc.localhost https://ipc.localhost lro: http://lro.localhost https://lro.localhost https://game.lastro.cn https://rodata.ltsd.ro https://ltsd.ro https://*.ltsd.ro",
        "base-uri": "'none'",
        "object-src": "'none'",
        "form-action": "'none'"
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"] }
}
