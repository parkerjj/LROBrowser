{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "native-probe",
  "version": "0.0.1",
  "identifier": "com.ioft.lroclient.probe",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "useHttpsScheme": true, "title": "probe", "url": "index.html", "width": 900, "height": 700 }],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": { "active": false }
}
